# Service ports
PAYMENT_SERVER_PORT=3001
CONSENT_SERVICE_PORT=3002
AUDIT_SERVICE_PORT=3003

# Service URLs (used for inter-service communication)
PAYMENT_SERVER_URL=http://localhost:3001
CONSENT_SERVICE_URL=http://localhost:3002
AUDIT_SERVICE_URL=http://localhost:3003

# Optional: path to a persisted DID identity (created by npm run generate-identity)
# If not set, an ephemeral did:key is generated on startup
IDENTITY_PATH=.kya-os/identity.json

# Optional: Bankee API key (for real payment execution)
# If not set, the server runs in mock mode with simulated payment responses
BANKEE_API_KEY=

# Consent VC time-to-live in seconds (default: 3600 = 1 hour)
DELEGATION_TTL_SECONDS=3600

# High-value payment threshold in minor units (default: 10000 = £100.00)
# Payments above this amount require human consent before execution
HIGH_VALUE_THRESHOLD=10000
